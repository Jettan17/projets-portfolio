---
/**
 * MyApproach - Zoom/depth effect section with GSAP
 * Quote text zooms from far away into screen as you scroll
 * Hidden skills are revealed by the cursor spotlight (hover-based)
 */

// Expanded skills wordlist - randomized positions on each build
const skills = [
  'React', 'TypeScript', 'JavaScript', 'HTML', 'CSS',
  'Next.js', 'Node.js', 'Python', 'Express', 'MongoDB',
  'Redis', 'REST APIs', 'Git', 'Docker', 'AWS', 'Vercel', 'CI/CD', 'Webpack', 'Vite'
];

// Generate random positions avoiding the center (where text is)
// Uses 8 zones for better distribution: 4 corners + 4 edges
function getRandomPosition(index: number): { top?: string; bottom?: string; left?: string; right?: string } {
  // Use index as seed for consistent but varied positions
  const seed = (index * 7919 + 104729) % 100;
  const seed2 = (index * 6151 + 88813) % 100;
  const seed3 = (index * 3571 + 71993) % 100;

  // 8 zones for even distribution
  const zone = index % 8;

  const positions: { top?: string; bottom?: string; left?: string; right?: string } = {};

  switch (zone) {
    case 0: // Top-left corner
      positions.top = `${15 + (seed % 15)}%`;
      positions.left = `${3 + (seed2 % 18)}%`;
      break;
    case 1: // Top-right corner
      positions.top = `${15 + (seed % 15)}%`;
      positions.right = `${3 + (seed2 % 18)}%`;
      break;
    case 2: // Bottom-left corner
      positions.bottom = `${5 + (seed % 15)}%`;
      positions.left = `${3 + (seed2 % 18)}%`;
      break;
    case 3: // Bottom-right corner
      positions.bottom = `${5 + (seed % 15)}%`;
      positions.right = `${3 + (seed2 % 18)}%`;
      break;
    case 4: // Top edge (middle area, avoiding center)
      positions.top = `${15 + (seed % 12)}%`;
      // Place in left-center or right-center of top edge
      if (seed3 < 50) {
        positions.left = `${22 + (seed2 % 10)}%`;
      } else {
        positions.right = `${22 + (seed2 % 10)}%`;
      }
      break;
    case 5: // Bottom edge (middle area, avoiding center)
      positions.bottom = `${3 + (seed % 12)}%`;
      if (seed3 < 50) {
        positions.left = `${22 + (seed2 % 10)}%`;
      } else {
        positions.right = `${22 + (seed2 % 10)}%`;
      }
      break;
    case 6: // Left edge (middle vertical)
      positions.left = `${2 + (seed % 12)}%`;
      // Place in upper-middle or lower-middle of left edge
      if (seed3 < 50) {
        positions.top = `${35 + (seed2 % 15)}%`;
      } else {
        positions.bottom = `${35 + (seed2 % 15)}%`;
      }
      break;
    case 7: // Right edge (middle vertical)
      positions.right = `${2 + (seed % 12)}%`;
      if (seed3 < 50) {
        positions.top = `${35 + (seed2 % 15)}%`;
      } else {
        positions.bottom = `${35 + (seed2 % 15)}%`;
      }
      break;
  }

  return positions;
}

// Shuffle and take a random subset (8-12 skills)
const shuffledSkills = [...skills]
  .sort(() => Math.random() - 0.5)
  .slice(0, 8 + Math.floor(Math.random() * 5));
---

<section class="my-approach panel">
  <div class="approach-bg" aria-hidden="true">
    <div class="grain-overlay"></div>
  </div>

  <!-- Hidden floating skills - revealed by cursor spotlight -->
  <div class="hidden-skills" id="hidden-skills" aria-hidden="true">
    {shuffledSkills.map((skill: string, index: number) => {
      const pos = getRandomPosition(index);
      const floatX = ((index % 2 === 0 ? 1 : -1) * (3 + (index % 5) * 2));
      const floatY = ((index % 3 === 0 ? -1 : 1) * (2 + (index % 4)));
      return (
        <span
          class="hidden-skill"
          style={`
            ${pos.top ? `top: ${pos.top};` : ''}
            ${pos.bottom ? `bottom: ${pos.bottom};` : ''}
            ${pos.left ? `left: ${pos.left};` : ''}
            ${pos.right ? `right: ${pos.right};` : ''}
            --delay: ${(index * 0.3) % 6}s;
            --float-x: ${floatX}px;
            --float-y: ${floatY}px;
          `}
        >
          {skill}
        </span>
      );
    })}
  </div>

  <div class="approach-content">
    <div class="quote-block">
      <p class="quote-text">
        <span class="quote-line desktop-text">Move your cursor</span>
        <span class="quote-line desktop-text accent">to focus</span>
        <span class="quote-line mobile-text">Slide horizontally<br/><span class="accent">to focus</span></span>
      </p>
    </div>

    <p class="approach-description">
      <span class="desktop-text hint">Guide the stars.</span>
    </p>
  </div>
</section>

<style>
  .my-approach {
    position: relative;
    height: 100vh;
    height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-dark);
    color: var(--text-light);
    overflow: hidden;
    perspective: 1000px;
  }

  /* Grain texture overlay */
  .approach-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .grain-overlay {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    opacity: 0.08;
    mix-blend-mode: overlay;
  }

  /* Hidden skills container */
  .hidden-skills {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  /* Individual hidden skill words */
  .hidden-skill {
    position: absolute;
    font-size: clamp(0.85rem, 2.5vw, 1.25rem);
    font-weight: var(--font-bold);
    color: rgba(34, 197, 94, 0.9);
    text-shadow: 0 0 10px rgba(34, 197, 94, 0.5);
    opacity: 0;
    transition: opacity 0.2s ease;
    animation: float 6s ease-in-out infinite;
    animation-delay: var(--delay, 0s);
    white-space: nowrap;
  }

  @keyframes float {
    0%, 100% {
      transform: translate(0, 0);
    }
    25% {
      transform: translate(var(--float-x, 5px), var(--float-y, -3px));
    }
    50% {
      transform: translate(calc(var(--float-x, 5px) * -0.5), calc(var(--float-y, -3px) * -1));
    }
    75% {
      transform: translate(calc(var(--float-x, 5px) * -1), var(--float-y, -3px));
    }
  }

  .approach-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: var(--space-4);
    max-width: 800px;
  }

  .quote-block {
    margin-bottom: var(--space-8);
    will-change: transform, opacity, filter;
  }

  .quote-text {
    font-size: clamp(2rem, 8vw, 4rem);
    font-weight: var(--font-bold);
    line-height: 1.2;
    margin: 0;
  }

  .quote-line {
    display: block;
  }

  .quote-line.accent,
  .quote-line .accent {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .approach-description {
    font-size: var(--text-lg);
    color: var(--text-tertiary);
    line-height: 1.7;
    margin: 0;
  }

  .approach-description .hint {
    display: block;
    font-size: var(--text-base);
    opacity: 0.8;
    margin-top: var(--space-2);
    font-style: italic;
  }

  /* Desktop/mobile text switching */
  .mobile-text {
    display: none;
  }

  @media (pointer: coarse) {
    .desktop-text {
      display: none !important;
    }

    .mobile-text {
      display: block;
    }
  }

  @media (max-width: 768px) {
    .hidden-skill {
      font-size: clamp(0.7rem, 2vw, 1rem);
    }
  }
</style>

<script is:inline>
  // Reveal skills when cursor spotlight is near them (hover-based)
  (function() {
    // Use window to store state across hot reloads
    if (!window._hiddenSkillsState) {
      window._hiddenSkillsState = {
        listenersAdded: false,
        rafId: null,
        skillPositions: []
      };
    }
    var state = window._hiddenSkillsState;
    var revealRadius = 100;
    var revealRadiusSquared = revealRadius * revealRadius;
    var outerRadiusSquared = (revealRadius * 1.5) * (revealRadius * 1.5);

    function getSkills() {
      return document.querySelectorAll('.hidden-skill, .hidden-word');
    }

    function getSpotlight() {
      return document.getElementById('cursor-spotlight');
    }

    function cacheSkillPositions() {
      var skills = getSkills();
      if (!skills.length) return;
      state.skillPositions = [];
      skills.forEach(function(skill) {
        var rect = skill.getBoundingClientRect();
        state.skillPositions.push({
          el: skill,
          centerX: rect.left + rect.width / 2,
          centerY: rect.top + rect.height / 2
        });
      });
    }

    function checkSkillsVisibility() {
      var cursorSpotlight = getSpotlight();
      var skills = getSkills();
      if (!cursorSpotlight || !skills.length) return;

      var isSpotlightActive = cursorSpotlight.classList.contains('active');

      if (!isSpotlightActive) {
        skills.forEach(function(skill) {
          skill.style.opacity = '0';
        });
        return;
      }

      var spotlightX = parseFloat(cursorSpotlight.style.left) || 0;
      var spotlightY = parseFloat(cursorSpotlight.style.top) || 0;

      // Re-cache positions if needed
      if (state.skillPositions.length !== skills.length) {
        cacheSkillPositions();
      }

      state.skillPositions.forEach(function(pos) {
        var dx = spotlightX - pos.centerX;
        var dy = spotlightY - pos.centerY;
        var distanceSquared = dx * dx + dy * dy;

        if (distanceSquared < revealRadiusSquared) {
          var distance = Math.sqrt(distanceSquared);
          var opacity = 1 - (distance / revealRadius) * 0.3;
          pos.el.style.opacity = Math.max(0.7, opacity).toString();
        } else if (distanceSquared < outerRadiusSquared) {
          var distance = Math.sqrt(distanceSquared);
          var fadeOpacity = 1 - ((distance - revealRadius) / (revealRadius * 0.5));
          pos.el.style.opacity = Math.max(0, fadeOpacity * 0.5).toString();
        } else {
          pos.el.style.opacity = '0';
        }
      });
    }

    function handleMove(e) {
      if (state.rafId) return;
      state.rafId = requestAnimationFrame(function() {
        state.rafId = null;
        checkSkillsVisibility();
      });
    }

    function handleScrollResize() {
      cacheSkillPositions();
    }

    // Only add listeners once
    if (!state.listenersAdded) {
      state.listenersAdded = true;
      document.addEventListener('mousemove', handleMove);
      document.addEventListener('touchmove', handleMove);
      window.addEventListener('scroll', handleScrollResize, { passive: true });
      window.addEventListener('resize', handleScrollResize);
    }

    // Initialize positions
    cacheSkillPositions();
  })();
</script>
