---
/**
 * IntroSplash - Fullscreen intro section with GSAP scroll-driven animations
 * Simple text fade effect for platform cycling + cursor spotlight on hold
 */
import personal from '../data/personal.json';
import HiddenWords from './HiddenWords.astro';

const introWords = ['Syntax', 'Render', 'Compile', 'Runtime', 'Recursive', 'Loop', 'Execute'];
---

<section class="intro-splash panel">
  <div class="intro-bg" aria-hidden="true">
    <div class="intro-blob intro-blob-1"></div>
    <div class="intro-blob intro-blob-2"></div>
  </div>

  <HiddenWords words={introWords} count={6} />

  <div class="intro-content">
    <h1 class="intro-title">
      <span class="line line-1">I build things for</span>
      <span class="line line-2">
        <!-- Simple text with decorative spotlight behind -->
        <span class="platform-area">
          <span class="platform-glow" aria-hidden="true"></span>
          <span class="platform-text" id="platform-text">the web</span>
        </span>
      </span>
    </h1>
  </div>

  <div class="scroll-indicator" aria-hidden="true">
    <span class="scroll-text">Scroll</span>
    <div class="scroll-arrow">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 5v14M5 12l7 7 7-7"/>
      </svg>
    </div>
  </div>
</section>

<style>
  .intro-splash {
    position: relative;
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--bg-primary);
    overflow: hidden;
  }

  /* Background blobs */
  .intro-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .intro-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.5;
  }

  .intro-blob-1 {
    top: 20%;
    right: 15%;
    width: 350px;
    height: 350px;
    background: var(--color-primary);
  }

  .intro-blob-2 {
    bottom: 25%;
    left: 10%;
    width: 280px;
    height: 280px;
    background: var(--color-secondary-dark);
  }

  /* Mobile: Smaller blobs, lower opacity, positioned at edges */
  @media (max-width: 768px) {
    .intro-blob {
      opacity: 0.35;
    }

    .intro-blob-1 {
      top: 5%;
      right: -15%;
      width: 180px;
      height: 180px;
    }

    .intro-blob-2 {
      bottom: 10%;
      left: -15%;
      width: 150px;
      height: 150px;
    }
  }

  /* Content */
  .intro-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: var(--space-4);
  }

  .intro-title {
    font-size: clamp(2.5rem, 10vw, 5rem);
    font-weight: var(--font-extrabold);
    line-height: 1.1;
    margin: 0;
  }

  .line {
    display: block;
  }

  /* Platform text area */
  .platform-area {
    position: relative;
    display: inline-block;
  }

  /* Spotlight glow behind text - shifted up slightly */
  .platform-glow {
    position: absolute;
    top: 58%;
    left: 50%;
    width: 140px;
    height: 140px;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(42, 157, 143, 0.45) 0%,
      rgba(42, 157, 143, 0.2) 50%,
      transparent 75%
    );
    box-shadow:
      0 0 15px rgba(42, 157, 143, 0.35),
      0 0 30px rgba(42, 157, 143, 0.15);
    opacity: 1;
    transition: opacity 0.1s ease; /* Spotlight reappears immediately */
  }

  /* Spotlight hides first (no delay on hide) */
  .platform-area.fading .platform-glow {
    opacity: 0;
    transition: opacity 0.1s ease; /* Spotlight fades out first */
  }

  /* The actual text - simple gradient */
  .platform-text {
    display: inline-block;
    min-width: 3ch;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    position: relative;
    z-index: 1;
    opacity: 1;
    transition: opacity 0.1s ease 0.1s; /* Text reappears 100ms after spotlight */
  }

  /* Text hides 100ms after spotlight starts hiding */
  .platform-area.fading .platform-text {
    opacity: 0;
    transition: opacity 0.1s ease 0.1s;
  }

  /* Scroll indicator */
  .scroll-indicator {
    position: absolute;
    bottom: var(--space-8);
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-tertiary);
  }

  .scroll-text {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .scroll-arrow {
    animation: bounce 2s ease-in-out infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px); }
  }
</style>

<script is:inline>
  // Platform cycling animation - simple fade approach
  (function() {
    var platforms = ['the web', 'mobile', 'desktop', 'fun', 'myself'];
    var currentIndex = 0;

    function cyclePlatform() {
      var area = document.querySelector('.platform-area');
      var element = document.getElementById('platform-text');
      if (!area || !element) return;

      // Fade out text and glow
      area.classList.add('fading');

      // After fade out, change text and fade back in (longer invisible duration)
      setTimeout(function() {
        currentIndex = (currentIndex + 1) % platforms.length;
        element.textContent = platforms[currentIndex];

        // Fade back in
        area.classList.remove('fading');
      }, 400);
    }

    // Start cycling after initial delay
    setTimeout(function() {
      setInterval(cyclePlatform, 3000);
    }, 2500);
  })();
</script>
