---
/**
 * WhatIDo - Horizontal scroll section with GSAP
 * Displays randomized project logos in cards that scroll horizontally
 */
import { readdirSync } from 'fs';
import { join } from 'path';
import HiddenWords from './HiddenWords.astro';

const buildWords = ['Serverless', 'Headless', 'Microservices', 'GraphQL', 'Realtime'];

// Get available logos from /public/logos/
const logosDir = join(process.cwd(), 'public', 'logos');
let availableLogos: string[] = [];

try {
  const files = readdirSync(logosDir);
  availableLogos = files
    .filter(f => f.endsWith('.svg') || f.endsWith('.png'))
    .map(f => `/logos/${f}`);
} catch (e) {
  // Fallback if directory doesn't exist
  availableLogos = ['/logos/learnex.svg', '/logos/prizm.svg', '/logos/stratos.svg'];
}

// Shuffle array using Fisher-Yates
function shuffle<T>(array: T[]): T[] {
  const shuffled = [...array];
  for (let i = shuffled.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
  }
  return shuffled;
}

// Get 3 random logos (or all if less than 3)
const displayLogos = shuffle(availableLogos).slice(0, 3);

// Gradient options for visual variety
const gradients = ['primary', 'secondary', 'accent'];
---

<section class="what-i-do panel">
  <HiddenWords words={buildWords} count={6} />
  <div class="what-content">
    <h2 class="what-title">What I've Built</h2>

    <div class="focus-cards-wrapper">
      <div class="focus-cards-track">
        {displayLogos.map((logo, index) => (
          <div class="focus-card">
            <div class={`logo-container logo-container--${gradients[index % gradients.length]}`}>
              <img
                src={logo}
                alt={`Project logo ${index + 1}`}
                class="project-logo"
                loading="eager"
              />
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .what-i-do {
    position: relative;
    height: 100vh;
    height: 100dvh;
    display: flex;
    align-items: center;
    background: var(--bg-secondary);
    overflow: hidden;
  }

  .what-content {
    width: 100%;
    padding: var(--space-4);
  }

  .what-title {
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-12);
    text-align: center;
    color: var(--text-primary);
  }

  .focus-cards-wrapper {
    width: 100%;
    overflow: visible;
  }

  .focus-cards-track {
    display: flex;
    gap: var(--space-8);
    padding: 0 calc(50vw - 140px); /* Center first card (280px / 2) */
    will-change: transform;
  }

  .focus-card {
    flex-shrink: 0;
    width: 280px;
    height: 280px;
    padding: var(--space-6);
    background: var(--bg-primary);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-container {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    position: relative;
    overflow: hidden;
  }

  .logo-container::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.15;
    border-radius: inherit;
  }

  .logo-container--primary::before {
    background: var(--gradient-primary);
  }

  .logo-container--secondary::before {
    background: var(--gradient-secondary);
  }

  .logo-container--accent::before {
    background: var(--gradient-accent);
  }

  .project-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.15));
    transition: transform 0.3s ease;
  }

  .focus-card:hover .project-logo,
  .focus-card:active .project-logo {
    transform: scale(1.05);
  }

  /* Mobile: Keep horizontal, adjust sizing */
  @media (max-width: 768px) {
    .focus-cards-track {
      padding: 0 calc(50vw - 100px); /* Center first card (200px / 2) */
      gap: var(--space-4);
    }

    .focus-card {
      width: 200px;
      height: 200px;
    }
  }
</style>
