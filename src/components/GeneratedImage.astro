---
/**
 * Generated image placeholder for projects
 * Supports 5 visual styles with deterministic assignment per project
 * Optionally displays project logo on top of styled background
 */

import {
  getFontForRepo,
  getUniqueProjectColors,
  getProjectStyle,
  type ImageStyle,
} from '../lib/github/image-generator';

interface Props {
  title: string;
  repoName?: string;
  language?: string | null;
  tags?: string[];
  logoUrl?: string | null;
  large?: boolean;
}

const { title, repoName = title, language = null, tags = [], logoUrl = null, large = false } = Astro.props;

// Get unique colors and style for this project
const colors = getUniqueProjectColors(repoName);
const style = getProjectStyle(repoName);
const fontFamily = getFontForRepo(repoName);

// CSS custom properties for this project
const cssVars = `
  --primary: ${colors.primary};
  --secondary: ${colors.secondary};
  --accent: ${colors.accent};
  --hue: ${colors.hue};
  --display-font: '${fontFamily}', system-ui, sans-serif;
`;

const hasLogo = !!logoUrl;
---

<div
  class={`generated-image-wrapper style-${style} ${hasLogo ? 'has-logo' : ''} ${large ? 'large' : ''}`}
  style={cssVars}
  data-style={style}
>
  <div class="generated-image">
    <!-- Style 1: Diagonal - bold accent line -->
    {style === 'diagonal' && (
      <div class="diagonal-line"></div>
    )}

    <!-- Style 2: Corners - dual corners with glow -->
    {style === 'corners' && (
      <>
        <div class="corner-accent corner-top-left"></div>
        <div class="corner-accent corner-bottom-right"></div>
      </>
    )}

    <!-- Style 3: Dots - glowing dot grid -->
    {style === 'dots' && (
      <svg class="dots-svg" viewBox="0 0 400 250" preserveAspectRatio="xMidYMid slice">
        <!-- Row 1: y=25 -->
        <circle class="dot" cx="25"  cy="25"  r="3" opacity="0.12"/>
        <circle class="dot" cx="75"  cy="25"  r="3" opacity="0.10"/>
        <circle class="dot" cx="125" cy="25"  r="3" opacity="0.15"/>
        <circle class="dot" cx="175" cy="25"  r="3" opacity="0.10"/>
        <circle class="dot" cx="225" cy="25"  r="3" opacity="0.18"/>
        <circle class="dot" cx="275" cy="25"  r="3" opacity="0.12"/>
        <circle class="dot-halo" cx="325" cy="25"  r="9" opacity="0.15"/>
        <circle class="dot-mid" cx="325" cy="25"  r="3" opacity="0.60"/>
        <circle class="dot" cx="375" cy="25"  r="3" opacity="0.10"/>
        <!-- Row 2: y=75 -->
        <circle class="dot" cx="25"  cy="75"  r="3" opacity="0.10"/>
        <circle class="dot" cx="75"  cy="75"  r="3" opacity="0.20"/>
        <circle class="dot" cx="125" cy="75"  r="3" opacity="0.12"/>
        <circle class="dot-halo" cx="175" cy="75"  r="9" opacity="0.15"/>
        <circle class="dot-mid" cx="175" cy="75"  r="3" opacity="0.65"/>
        <circle class="dot-halo" cx="225" cy="75"  r="18" opacity="0.16"/>
        <circle class="dot-halo" cx="225" cy="75"  r="10" opacity="0.36"/>
        <circle class="dot-bright" cx="225" cy="75"  r="3" opacity="0.98"/>
        <circle class="dot-halo" cx="275" cy="75"  r="9" opacity="0.15"/>
        <circle class="dot-mid" cx="275" cy="75"  r="3" opacity="0.65"/>
        <circle class="dot" cx="325" cy="75"  r="3" opacity="0.18"/>
        <circle class="dot" cx="375" cy="75"  r="3" opacity="0.10"/>
        <!-- Row 3: y=125 -->
        <circle class="dot" cx="25"  cy="125" r="3" opacity="0.15"/>
        <circle class="dot" cx="75"  cy="125" r="3" opacity="0.12"/>
        <circle class="dot-halo" cx="125" cy="125" r="9" opacity="0.15"/>
        <circle class="dot-mid" cx="125" cy="125" r="3" opacity="0.55"/>
        <circle class="dot-halo" cx="175" cy="125" r="9" opacity="0.15"/>
        <circle class="dot-mid" cx="175" cy="125" r="3" opacity="0.70"/>
        <circle class="dot-halo" cx="225" cy="125" r="14" opacity="0.12"/>
        <circle class="dot-halo" cx="225" cy="125" r="8"  opacity="0.28"/>
        <circle class="dot-bright" cx="225" cy="125" r="3" opacity="0.85"/>
        <circle class="dot-halo" cx="275" cy="125" r="9" opacity="0.15"/>
        <circle class="dot-mid" cx="275" cy="125" r="3" opacity="0.65"/>
        <circle class="dot" cx="325" cy="125" r="3" opacity="0.20"/>
        <circle class="dot" cx="375" cy="125" r="3" opacity="0.12"/>
        <!-- Row 4: y=175 -->
        <circle class="dot" cx="25"  cy="175" r="3" opacity="0.10"/>
        <circle class="dot" cx="75"  cy="175" r="3" opacity="0.15"/>
        <circle class="dot" cx="125" cy="175" r="3" opacity="0.18"/>
        <circle class="dot-halo" cx="175" cy="175" r="10" opacity="0.08"/>
        <circle class="dot-halo" cx="175" cy="175" r="6"  opacity="0.18"/>
        <circle class="dot-bright" cx="175" cy="175" r="3" opacity="0.65"/>
        <circle class="dot-halo" cx="225" cy="175" r="9" opacity="0.15"/>
        <circle class="dot-mid" cx="225" cy="175" r="3" opacity="0.60"/>
        <circle class="dot" cx="275" cy="175" r="3" opacity="0.20"/>
        <circle class="dot" cx="325" cy="175" r="3" opacity="0.12"/>
        <circle class="dot" cx="375" cy="175" r="3" opacity="0.10"/>
        <!-- Row 5: y=225 -->
        <circle class="dot" cx="25"  cy="225" r="3" opacity="0.10"/>
        <circle class="dot" cx="75"  cy="225" r="3" opacity="0.12"/>
        <circle class="dot" cx="125" cy="225" r="3" opacity="0.15"/>
        <circle class="dot" cx="175" cy="225" r="3" opacity="0.20"/>
        <circle class="dot" cx="225" cy="225" r="3" opacity="0.18"/>
        <circle class="dot-halo" cx="275" cy="225" r="9" opacity="0.15"/>
        <circle class="dot-mid" cx="275" cy="225" r="3" opacity="0.55"/>
        <circle class="dot" cx="325" cy="225" r="3" opacity="0.12"/>
        <circle class="dot" cx="375" cy="225" r="3" opacity="0.10"/>
      </svg>
    )}

    <!-- Style 4: Rings - concentric circles (radar/sonar) -->
    {style === 'rings' && (
      <svg class="rings-svg" viewBox="0 0 400 250" preserveAspectRatio="xMidYMid meet">
        <circle class="ring ring-outer" cx="200" cy="125" r="110" />
        <circle class="ring ring-mid"   cx="200" cy="125" r="68"  />
        <circle class="ring ring-inner" cx="200" cy="125" r="28"  />
      </svg>
    )}

    <!-- Style 5: Cross - hairline crosshair -->
    {style === 'cross' && (
      <>
        <div class="cross-h"></div>
        <div class="cross-v"></div>
      </>
    )}

    <!-- Logo display (if available) -->
    {hasLogo && (
      <div class="logo-container">
        <img src={logoUrl} alt={`${title} logo`} class="project-logo" />
      </div>
    )}

    <!-- Title (only shown when no logo) -->
    {!hasLogo && (
      <span class="generated-title">{title}</span>
    )}
  </div>
</div>

<style>
  .generated-image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .generated-image {
    position: relative;
    width: 100%;
    height: 100%;
    background: #0d1117;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    gap: var(--space-2);
  }

  /* Dark mode: explicit reset to ensure filter is removed */
  :global([data-theme="dark"]) .generated-image {
    background: #0d1117;
    filter: none;
  }

  /* Light mode: lighter background + brightness/saturation boost */
  :global(html:not([data-theme="dark"])) .generated-image {
    background: #2d333b;
    filter: brightness(1.25) saturate(1.2);
  }

  /* Logo container - sized for horizontal logos with text */
  .logo-container {
    position: relative;
    z-index: 10;
    width: 80%;
    height: 45%;
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 4px 16px rgba(0, 0, 0, 0.5));
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  :global(.project-card:hover) .logo-container {
    transform: scale(1.05);
    filter: drop-shadow(0 6px 24px rgba(0, 0, 0, 0.6));
  }

  .project-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .generated-title {
    position: relative;
    z-index: 10;
    font-family: var(--display-font);
    font-size: clamp(1.5rem, 5vw, 2.5rem);
    font-weight: 600;
    color: white;
    text-align: center;
    text-shadow: 0 4px 12px rgba(0, 0, 0, 0.5);
    padding: var(--space-4);
    max-width: 90%;
    line-height: 1.2;
  }

  .large .generated-title {
    font-size: clamp(2.5rem, 8vw, 4rem);
  }

  /* ==========================================================================
     STYLE 1: DIAGONAL - Single bold diagonal accent line
     ========================================================================== */
  .style-diagonal .diagonal-line {
    position: absolute;
    width: 200%;
    height: 6px;
    background: linear-gradient(90deg,
      transparent 0%,
      var(--primary) 20%,
      var(--secondary) 50%,
      var(--primary) 80%,
      transparent 100%
    );
    top: 50%;
    left: -50%;
    transform: rotate(-35deg) translateY(-50%);
    filter: blur(1px);
    box-shadow:
      0 0 20px var(--primary),
      0 0 40px var(--secondary);
    opacity: 0.9;
    transition: opacity 0.3s ease, box-shadow 0.3s ease;
  }

  .style-diagonal.has-logo .diagonal-line {
    opacity: 0.6;
  }

  .style-diagonal::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 60% 40%, var(--primary) 0%, transparent 50%);
    opacity: 0.15;
  }

  .style-diagonal.has-logo::before {
    opacity: 0.1;
  }

  :global(.project-card:hover) .style-diagonal .diagonal-line {
    opacity: 1;
    box-shadow:
      0 0 30px var(--primary),
      0 0 60px var(--secondary);
  }

  :global(.project-card:hover) .style-diagonal.has-logo .diagonal-line {
    opacity: 0.75;
  }

  /* ==========================================================================
     STYLE 2: CORNERS - Dual corners with enhanced glow effect
     ========================================================================== */
  .style-corners .corner-accent {
    position: absolute;
    width: 35%;
    height: 35%;
    opacity: 0.8;
    filter: drop-shadow(0 0 15px var(--primary)) drop-shadow(0 0 40px var(--secondary));
    transition: opacity 0.3s ease, transform 0.3s ease, filter 0.3s ease;
  }

  .style-corners.has-logo .corner-accent {
    opacity: 0.5;
  }

  .style-corners .corner-top-left {
    top: 0;
    left: 0;
    background: linear-gradient(135deg, var(--primary), var(--secondary) 70%, transparent);
    clip-path: polygon(0 0, 100% 0, 0 100%);
    transform-origin: top left;
    box-shadow:
      0 0 15px var(--primary),
      0 0 40px var(--primary),
      0 0 80px var(--secondary);
  }

  .style-corners .corner-bottom-right {
    bottom: 0;
    right: 0;
    background: linear-gradient(315deg, var(--secondary), var(--primary) 70%, transparent);
    clip-path: polygon(100% 0, 100% 100%, 0 100%);
    transform-origin: bottom right;
    box-shadow:
      0 0 15px var(--primary),
      0 0 40px var(--primary),
      0 0 80px var(--secondary);
  }

  :global(.project-card:hover) .style-corners .corner-accent {
    opacity: 0.95;
    transform: scale(1.1);
    filter: drop-shadow(0 0 25px var(--primary)) drop-shadow(0 0 60px var(--secondary));
  }

  :global(.project-card:hover) .style-corners.has-logo .corner-accent {
    opacity: 0.7;
  }

  /* ==========================================================================
     STYLE 3: DOTS - Glowing dot grid
     ========================================================================== */
  .style-dots .dots-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .style-dots .dot {
    fill: var(--primary);
    transition: opacity 0.3s ease;
  }

  .style-dots .dot-mid {
    fill: hsl(var(--hue), 80%, 72%);
  }

  .style-dots .dot-halo {
    fill: hsl(var(--hue), 80%, 70%);
    filter: blur(5px);
  }

  .style-dots .dot-bright {
    fill: hsl(var(--hue), 80%, 70%);
    opacity: 0.95;
  }

  .style-dots.has-logo .dot {
    opacity: 0.5 !important;
  }

  .style-dots.has-logo .dot-mid {
    opacity: 0.25 !important;
  }

  .style-dots.has-logo .dot-halo {
    opacity: 0.08 !important;
  }

  .style-dots.has-logo .dot-bright {
    opacity: 0.7;
  }

  /* ==========================================================================
     STYLE 4: RINGS - Concentric circles (radar/sonar aesthetic)
     ========================================================================== */
  .style-rings .rings-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .ring {
    fill: none;
    stroke: var(--primary);
    transition: opacity 0.3s ease;
  }

  .ring-outer {
    stroke-width: 1.5;
    opacity: 0.12;
  }

  .ring-mid {
    stroke-width: 2.5;
    opacity: 0.35;
  }

  .ring-inner {
    stroke-width: 3.5;
    opacity: 0.7;
    filter: drop-shadow(0 0 8px var(--primary)) drop-shadow(0 0 20px var(--secondary));
  }

  .style-rings.has-logo .ring-outer { opacity: 0.08; }
  .style-rings.has-logo .ring-mid   { opacity: 0.20; }
  .style-rings.has-logo .ring-inner { opacity: 0.45; }

  :global(.project-card:hover) .ring-outer { opacity: 0.20; }
  :global(.project-card:hover) .ring-mid   { opacity: 0.50; }
  :global(.project-card:hover) .ring-inner {
    opacity: 0.9;
    filter: drop-shadow(0 0 12px var(--primary)) drop-shadow(0 0 30px var(--secondary));
  }

  /* ==========================================================================
     STYLE 5: CROSS - Hairline crosshair with glowing center dot
     ========================================================================== */
  .cross-h,
  .cross-v {
    position: absolute;
    background: var(--primary);
    opacity: 0.35;
    transition: opacity 0.3s ease, box-shadow 0.3s ease;
  }

  .cross-h {
    width: 100%;
    height: 2px;
    min-height: 2px;
    top: 50%;
    box-shadow: 0 0 8px var(--primary), 0 0 20px var(--secondary);
  }

  .cross-v {
    height: 100%;
    width: 2px;
    min-width: 2px;
    left: 50%;
    box-shadow: 0 0 8px var(--primary), 0 0 20px var(--secondary);
  }

  .style-cross.has-logo .cross-h,
  .style-cross.has-logo .cross-v {
    opacity: 0.20;
  }

  :global(.project-card:hover) .cross-h,
  :global(.project-card:hover) .cross-v {
    opacity: 0.55;
    box-shadow: 0 0 14px var(--primary), 0 0 35px var(--secondary);
  }

  /* ==========================================================================
     LIGHT MODE BRIGHTNESS BOOST
     Increase opacity/vibrancy for all styles in light mode
     ========================================================================== */

  /* Diagonal - stronger glow in light mode */
  :global(:not([data-theme="dark"])) .style-diagonal .diagonal-line {
    opacity: 1;
    box-shadow:
      0 0 50px var(--primary),
      0 0 100px var(--secondary);
  }
  :global(:not([data-theme="dark"])) .style-diagonal::before {
    opacity: 0.3;
  }

  /* Corners - brighter in light mode */
  :global(:not([data-theme="dark"])) .style-corners .corner-accent {
    opacity: 1;
    filter: drop-shadow(0 0 20px var(--primary)) drop-shadow(0 0 60px var(--secondary));
  }

  /* Dots - light mode: halos already vivid, no extra boost needed */

  /* Rings - stronger glow in light mode */
  :global(:not([data-theme="dark"])) .ring-inner {
    opacity: 0.85;
    filter: drop-shadow(0 0 12px var(--primary)) drop-shadow(0 0 30px var(--secondary));
  }
  :global(:not([data-theme="dark"])) .ring-mid   { opacity: 0.50; }
  :global(:not([data-theme="dark"])) .ring-outer  { opacity: 0.20; }

  /* Cross - stronger glow in light mode */
  :global(:not([data-theme="dark"])) .cross-h,
  :global(:not([data-theme="dark"])) .cross-v {
    opacity: 0.55;
    box-shadow: 0 0 14px var(--primary), 0 0 35px var(--secondary);
  }
</style>
