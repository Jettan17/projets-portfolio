---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CursorGlow from '../components/CursorGlow.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Personal portfolio showcasing creative web development projects"
} = Astro.props;

const siteTitle = "projets";
const fullTitle = title === "Home" ? siteTitle : `${title} | ${siteTitle}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@600&family=JetBrains+Mono:wght@600&family=Playfair+Display:wght@600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Roboto+Slab:wght@600&family=Space+Grotesk:wght@600&display=swap" rel="stylesheet" />

    <title>{fullTitle}</title>

    <!-- Theme initialization - always dark mode -->
    <script is:inline>
      (function() {
        document.documentElement.setAttribute('data-theme', 'dark');
      })();
    </script>
  </head>
  <body>
    <CursorGlow />
    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <!-- Global green cursor spotlight (shows on hold anywhere) -->
    <div class="cursor-spotlight" id="cursor-spotlight" aria-hidden="true"></div>
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
    padding-top: var(--header-height);
  }
</style>

<style is:global>
  /* Global green cursor spotlight - must be is:global to apply to dynamically created element */
  .cursor-spotlight {
    position: fixed;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 9998;
    opacity: 0;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      circle,
      rgba(34, 197, 94, 0.6) 0%,
      rgba(34, 197, 94, 0.4) 30%,
      rgba(34, 197, 94, 0.1) 60%,
      transparent 80%
    );
    border: 3px solid rgba(34, 197, 94, 0.7);
    box-shadow:
      0 0 30px rgba(34, 197, 94, 0.5),
      0 0 60px rgba(34, 197, 94, 0.3),
      inset 0 0 20px rgba(34, 197, 94, 0.2);
    transition: opacity 0.15s ease;
  }

  .cursor-spotlight.active {
    opacity: 1;
  }
</style>

<!-- Global cursor spotlight script - Mouse (with dead zone) + Touch support -->
<script is:inline>
  (function() {
    // Use window to store state across hot reloads
    if (!window._cursorSpotlightState) {
      window._cursorSpotlightState = {
        hideTimeout: null,
        isActive: false,
        listenersAdded: false,
        // Dead zone tracking
        movementDistance: 0,
        lastX: 0,
        lastY: 0,
        hasInitialPosition: false,
        // Mobile scroll lock
        isTouchGesture: false,
        scrollLocked: false
      };
    }
    var state = window._cursorSpotlightState;
    var ACTIVATION_THRESHOLD = 50; // pixels of movement required

    function getSpotlight() {
      return document.getElementById('cursor-spotlight');
    }

    function updatePosition(el, x, y) {
      el.style.left = x + 'px';
      el.style.top = y + 'px';
    }

    function showSpotlight(el) {
      var puzzleLockActive = document.getElementById('puzzle-section') !== null;
      if (puzzleLockActive || !el) return;

      if (state.hideTimeout) {
        clearTimeout(state.hideTimeout);
        state.hideTimeout = null;
      }

      if (!state.isActive) {
        state.isActive = true;
        el.classList.add('active');
        el.style.opacity = '1';
      }

      // Lock page scroll on mobile when spotlight activates
      if (state.isTouchGesture && !state.scrollLocked) {
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
        state.scrollLocked = true;
      }
    }

    function scheduleHide(el) {
      if (state.hideTimeout) {
        clearTimeout(state.hideTimeout);
      }
      state.hideTimeout = setTimeout(function() {
        state.isActive = false;
        state.movementDistance = 0; // Reset dead zone on hide
        if (el) {
          el.classList.remove('active');
          el.style.opacity = '0';
        }
      }, 300);
    }

    function handleMouseMove(e) {
      var el = getSpotlight();
      if (!el) return;

      var puzzleLockActive = document.getElementById('puzzle-section') !== null;
      if (puzzleLockActive) return;

      // Always update position so spotlight follows cursor
      updatePosition(el, e.clientX, e.clientY);

      // Track movement distance for dead zone
      if (!state.hasInitialPosition) {
        state.lastX = e.clientX;
        state.lastY = e.clientY;
        state.hasInitialPosition = true;
        return;
      }

      var dx = e.clientX - state.lastX;
      var dy = e.clientY - state.lastY;
      state.movementDistance += Math.sqrt(dx * dx + dy * dy);
      state.lastX = e.clientX;
      state.lastY = e.clientY;

      // Only show after threshold movement
      if (state.movementDistance < ACTIVATION_THRESHOLD) {
        return;
      }

      showSpotlight(el);
      scheduleHide(el);
    }

    function handleMouseLeave() {
      var el = getSpotlight();
      state.isActive = false;
      state.movementDistance = 0;
      state.hasInitialPosition = false;
      if (el) {
        el.classList.remove('active');
        el.style.opacity = '0';
      }
    }

    // Touch handlers - detect direction before activating spotlight
    // Prevents spotlight from interfering with vertical scrolling
    var DIRECTION_THRESHOLD = 10; // px to determine gesture direction
    var touchStartX = 0;
    var touchStartY = 0;
    var touchDecided = false; // whether we've decided scroll vs spotlight
    var touchIsScroll = false; // true = vertical scroll, skip spotlight

    function handleTouchStart(e) {
      if (!e.touches.length) return;

      var puzzleLockActive = document.getElementById('puzzle-section') !== null;
      if (puzzleLockActive) return;

      var touch = e.touches[0];
      touchStartX = touch.clientX;
      touchStartY = touch.clientY;
      touchDecided = false;
      touchIsScroll = false;
      state.isTouchGesture = true;

      // Position the spotlight but don't show it yet
      var el = getSpotlight();
      if (el) {
        updatePosition(el, touch.clientX, touch.clientY);
      }
    }

    function handleTouchMove(e) {
      var el = getSpotlight();
      if (!el || !e.touches.length) return;

      var puzzleLockActive = document.getElementById('puzzle-section') !== null;
      if (puzzleLockActive) return;

      var touch = e.touches[0];

      // If already decided this is a scroll, just bail out
      if (touchDecided && touchIsScroll) return;

      // If not yet decided, check direction
      if (!touchDecided) {
        var dx = Math.abs(touch.clientX - touchStartX);
        var dy = Math.abs(touch.clientY - touchStartY);

        // Wait until we have enough movement to decide
        if (dx < DIRECTION_THRESHOLD && dy < DIRECTION_THRESHOLD) return;

        touchDecided = true;
        // If vertical movement dominates, it's a scroll - don't show spotlight
        touchIsScroll = dy > dx;
        if (touchIsScroll) return;
      }

      // Horizontal gesture - activate spotlight and block scrolling
      e.preventDefault();
      updatePosition(el, touch.clientX, touch.clientY);
      showSpotlight(el);
    }

    function handleTouchEnd() {
      var el = getSpotlight();
      state.isActive = false;
      touchDecided = false;
      touchIsScroll = false;
      state.isTouchGesture = false;

      // Unlock page scroll
      if (state.scrollLocked) {
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
        state.scrollLocked = false;
      }

      if (el) {
        el.classList.remove('active');
        el.style.opacity = '0';
      }
    }

    // Only add listeners once
    if (!state.listenersAdded) {
      state.listenersAdded = true;
      // Mouse events
      document.addEventListener('mousemove', handleMouseMove);
      document.addEventListener('mouseleave', handleMouseLeave);
      // Touch events
      document.addEventListener('touchstart', handleTouchStart, { passive: true });
      document.addEventListener('touchmove', handleTouchMove, { passive: false });
      document.addEventListener('touchend', handleTouchEnd);
      document.addEventListener('touchcancel', handleTouchEnd);
    }
  })();
</script>
